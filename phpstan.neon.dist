includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    # Level 8 is the gate for every package (needs return types and
    # parameter types everywhere, null-safety, no mixed method calls).
    # Raise to 9 once the package has no `mixed` left.
    level: 8

    # Analyze as the oldest PHP composer.json allows.
    phpVersion: 80200

    paths:
        - src
        - config
        - tests

    # Do not trust a docblock over the signature.
    treatPhpDocTypesAsCertain: false

    # Packages must not read env() outside config/. Larastan ships a rule
    # for this; keep it enabled.

    # Larastan only recognizes the host app's config/ directory, so it flags
    # the package's own config file, which is where env() belongs.
    ignoreErrors:
        -
            identifier: larastan.noEnvCallsOutsideOfConfig
            path: config/hash_list.php
