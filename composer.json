{
    "name": "keaton-php/laravel-hash-list",
    "description": "Hashed email lists (do-not-contact, banned addresses) with streamed import and export and one-query membership checks. No plain address is ever stored.",
    "keywords": [
        "laravel",
        "laravel-hash-list",
        "email",
        "hash",
        "md5",
        "sha256",
        "privacy",
        "do-not-contact",
        "blocklist",
        "validation"
    ],
    "homepage": "https://github.com/keaton-php/laravel-hash-list",
    "support": {
        "issues": "https://github.com/keaton-php/laravel-hash-list/issues",
        "source": "https://github.com/keaton-php/laravel-hash-list",
        "docs": "https://kevineaton.dev/docs/laravel-hash-list/",
        "security": "https://github.com/keaton-php/laravel-hash-list/security/policy"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Kevin Eaton",
            "email": "kevin@kevineaton.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "illuminate/contracts": "^11.0||^12.0||^13.0",
        "illuminate/database": "^11.0||^12.0||^13.0",
        "illuminate/mail": "^11.0||^12.0||^13.0",
        "illuminate/support": "^11.0||^12.0||^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^9.0||^10.0||^11.0",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Keaton\\HashList\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Keaton\\HashList\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "format": "vendor/bin/pint",
        "lint": "vendor/bin/pint --test"
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Keaton\\HashList\\HashListServiceProvider"
            ],
            "aliases": {
                "HashList": "Keaton\\HashList\\Facades\\HashList"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
